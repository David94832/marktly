# Kopieer dit bestand naar .env en vul de echte waarden in.

# Poort waarop de Express-server draait
PORT=3001

# Pad naar het SQLite-databasebestand (optioneel, standaard: backend/data/marktly.db)
DATABASE_PATH=./data/marktly.db

# API key van de AI-provider die foto's naar product-info/advertentietekst omzet
AI_API_KEY=
